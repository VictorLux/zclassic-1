[Unit]
Description=ZClassic23 Watchdog — continuous health validator
After=zclassic23.service

[Service]
Type=simple
ExecStart=%h/zclassic23/zcl-watchdog -datadir=%h/.zclassic-c23 -interval=30
Restart=always
RestartSec=60
StandardOutput=append:%h/.zclassic-c23/watchdog.log
StandardError=append:%h/.zclassic-c23/watchdog.log

[Install]
WantedBy=default.target
